def linear_search(account_ids, target_id):
    """
    Linear Search to find if the target_id exists in account_ids.
    Time Complexity: O(n)
    """
    for account_id in account_ids:
        if account_id == target_id:
            return True
    return False


def binary_search(account_ids, target_id):
    """
    Binary Search to find if the target_id exists in account_ids.
    Requires the list to be sorted.
    Time Complexity: O(log n)
    """
    left, right = 0, len(account_ids) - 1

    while left <= right:
        mid = (left + right) // 2
        if account_ids[mid] == target_id:
            return True
        elif account_ids[mid] < target_id:
            left = mid + 1
        else:
            right = mid - 1

    return False


# Sample list of customer account IDs (unsorted)
customer_account_ids = [103, 101, 105, 108, 110, 107, 102]

# Target account ID to search
target_id = 108

# Perform Linear Search
print("Linear Search Result:")
found_linear = linear_search(customer_account_ids, target_id)
print(f"Customer ID {target_id} found: {found_linear}")

# Perform Binary Search (requires sorted list)
sorted_account_ids = sorted(customer_account_ids)
print("\nBinary Search Result (on sorted list):")
found_binary = binary_search(sorted_account_ids, target_id)
print(f"Customer ID {target_id} found: {found_binary}")
